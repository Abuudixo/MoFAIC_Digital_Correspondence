NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DOCUMENT_STORAGE_DIR=C:\mofaic-private-documents
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mofaic_correspondence?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
# Optional one-time administrator provisioning for npm run db:seed.
# Set all three values together; use a unique password of at least 12 characters.
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password
