NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DOCUMENT_STORAGE_DRIVER=local
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mofaic_correspondence?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
# Cloudflare R2 settings for shared uploaded documents.
# Set DOCUMENT_STORAGE_DRIVER=r2 and provide all four values.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=your-private-bucket-name
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional one-time administrator provisioning for npm run db:seed.
# Set all three values together; use a unique password of at least 12 characters.
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password
